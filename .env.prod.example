# Пример окружения для ПРОДАКШЕНА.
# Скопируйте на сервер как .env и заполните ВСЕ пустые значения.
#
# Переменные без значения обязательны: приложение не запустится, пока они
# не заданы (см. backend/config/env.py). Это сделано намеренно — тихий старт
# с небезопасным значением по умолчанию хуже явной ошибки на старте.

# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Смена SECRET_KEY инвалидирует все сессии — пользователи будут разлогинены.
SECRET_KEY=
DEBUG=0
# Домены через запятую, без протокола. Например: mooddiary.ru,www.mooddiary.ru
ALLOWED_HOSTS=
# Полные origin с протоколом. Например: https://mooddiary.ru
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Клиентское шифрование. На проде всегда 1.
ENCRYPTION_ENABLED=1

# HSTS: срок, на который браузер запоминает «этот домен только по HTTPS».
# Значение нельзя быстро отозвать, поэтому поднимаем лесенкой:
#   300 (5 минут, проверка) → 86400 (сутки) → 31536000 (год, рабочее значение)
SECURE_HSTS_SECONDS=300

# --- Gunicorn ---
# workers × threads = число соединений к PostgreSQL от одного контейнера.
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# --- PostgreSQL ---
DB_NAME=moods
DB_USER=moods
# Длинный случайный пароль, не переиспользовать из других сервисов.
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Длинный случайный пароль. Redis хранит кэш ответов всех пользователей.
REDIS_PASSWORD=
REDIS_DB=0

CACHE_TTL=86400
