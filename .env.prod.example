# Шаблон production-окружения: скопируйте в .env и заполните пустые значения.
# Обязательные переменные проверяет backend/config/env.py.

# --- Django ---
SECRET_KEY=
DEBUG=0
# Домены через запятую, без протокола.
ALLOWED_HOSTS=
# Полные origin с протоколом.
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

ENCRYPTION_ENABLED=1

# Повышайте HSTS постепенно: 300, 86400, затем 31536000 секунд.
SECURE_HSTS_SECONDS=300

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# --- PostgreSQL ---
DB_NAME=moods
DB_USER=moods
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

CACHE_TTL=86400
