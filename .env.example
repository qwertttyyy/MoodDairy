# Пример окружения для ЛОКАЛЬНОЙ РАЗРАБОТКИ.
# Скопируйте в .env: cp .env.example .env
#
# Для продакшена используйте .env.prod.example — здесь значения намеренно
# простые и на боевом сервере небезопасны.

# --- Django ---
# Любая случайная строка. Для прода генерировать заново:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-not-for-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
LOG_LEVEL=DEBUG

# Клиентское шифрование. 0 — записи хранятся открытым текстом,
# режим только для отладки и работы команды seed_moods.
ENCRYPTION_ENABLED=1

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# --- PostgreSQL ---
DB_NAME=moods
DB_USER=moods
DB_PASSWORD=moods
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password
REDIS_DB=0

# Время жизни кэшированных ответов, секунды (по умолчанию сутки).
CACHE_TTL=86400
