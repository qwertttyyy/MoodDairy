# Шаблон локального окружения: скопируйте в .env.
# Для production используйте .env.prod.example.

# --- Django ---
SECRET_KEY=dev-only-not-for-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
LOG_LEVEL=DEBUG

# Установите 0 для отладки и команды seed_moods.
ENCRYPTION_ENABLED=1

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# --- PostgreSQL ---
DB_NAME=moods
DB_USER=moods
DB_PASSWORD=moods
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password
REDIS_DB=0

CACHE_TTL=86400
